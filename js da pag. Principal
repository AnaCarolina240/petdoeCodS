}).addTo(map);

// Objeto para armazenar os marcadores
let markers = [];

// Função para obter o ícone baseado no tipo
function getIcon(type) {
  let iconUrl;
  switch (type) {
    case 'Clínica Veterinária':
      iconUrl = 'https://cdn-icons-png.flaticon.com/512/616/616408.png';
      break;
    case 'Castramóvel':
      iconUrl = 'https://cdn-icons-png.flaticon.com/512/3201/3201398.png';
      break;
    case 'Vacinação':
      iconUrl = 'https://cdn-icons-png.flaticon.com/512/1041/1041916.png';
      break;
    default:
      iconUrl = 'https://cdn-icons-png.flaticon.com/512/616/616408.png';
  }
  return L.icon({
    iconUrl: iconUrl,
    iconSize: [30, 30]
  });
}

// Função para carregar os dados do JSON e adicionar os marcadores
async function loadLocations() {
  try {
    const response = await fetch('locations.json');
    const data = await response.json();
    data.forEach(loc => {
      const marker = L.marker([loc.lat, loc.lng], { icon: getIcon(loc.type) })
        .bindPopup(`<b>${loc.type}</b><br>${loc.name}`);
      marker.type = loc.type; // Adiciona o tipo ao marcador
      marker.addTo(map);
      markers.push(marker);
    });
  } catch (error) {
    console.error('Erro ao carregar os dados:', error);
  }
}

// Função para buscar a localização baseada na cidade e estado
async function searchLocation() {
  const city = document.getElementById('cityInput').value.trim();
  const state = document.getElementById('stateInput').value.trim();

  if (!city || !state) {
    alert('Por favor, insira cidade e estado.');
    return;
  }

  const query = `${city}, ${state}, Brasil`;
  const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`;

  try {
    const response = await fetch(url);
    const data = await response.json();

    if (data && data.length > 0) {
      const location = data[0];
      map.setView([location.lat, location.lon], 13);
    } else {
      alert('Localização não encontrada.');
    }
  } catch (error) {
    console.error('Erro na busca de localização:', error);
  }
}

// Função para aplicar o filtro baseado nos checkboxes
function applyFilter() {
  const checkboxes = document.querySelectorAll('.filter-checkbox');
  const selectedTypes = Array.from(checkboxes)
    .filter(checkbox => checkbox.checked)
    .map(checkbox => checkbox.value);

  markers.forEach(marker => {
    if (selectedTypes.includes(marker.type)) {
      marker.addTo(map);
    } else {
      map.removeLayer(marker);
    }
  });
}

// Adiciona o evento de mudança nos checkboxes
document.querySelectorAll('.filter-checkbox').forEach(checkbox => {
  checkbox.addEventListener('change', applyFilter);
});

// Carrega os dados ao iniciar
loadLocations();

