body {
  background-color: #f2f2f2;
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
}

.container {
  width: 90%;
  max-width: 800px;
  margin: 30px auto;
  background-color: #fff;
  padding: 30px;
  border-radius: 10px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

h1, h2 {
  text-align: center;
  color: #000000;
}

label {
  display: block;
  margin-top: 15px;
  font-weight: bold;
}

input[type="text"],
input[type="email"],
input[type="password"],
input[type="tel"],
input[type="date"] {
  width: 100%;
  padding: 10px;
  margin-top: 5px;
  border: 1px solid #ffaf47;
  border-radius: 5px;
  box-sizing: border-box;
}

.radio-group {
  display: flex;
  gap: 15px;
  margin-top: 5px;
}

.radio-group label {
  font-weight: normal;
}

button {
  margin-top: 25px;
  background-color: #cf1414;
  color: white;
  padding: 12px;
  font-size: 16px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

button:hover {
  background-color: #a60f0f;
}

form button,
.plan .btn-assinar {
  display: block;
  margin: 25px auto 0;
}

.plans {
  display: flex;
  gap: 20px; 
  flex-wrap: wrap;
  justify-content: center; 
  margin-top: 30px;
}

.plan {
  flex: 1 1 300px; 
  max-width: 400px; 
  background-color: #ffacac;
  padding: 20px;
  border-radius: 3px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.plan h2 {
  margin-top: 0;
  color: #0c0606;
}

.plan ul {
  list-style: none;
  padding-left: 0;
}

.plan li {
  margin-bottom: 8px;
}

.price {
  font-size: 20px;
  font-weight: bold;
  margin-top: 10px;
  color: #cf1414;
}

@media (max-width: 768px) {
  .plans {
    flex-direction: column;
    align-items: center;
  }

  .plan {
    width: 100%;
  }
}

#btnPagar {
  margin-top: 15px;
  width: 100%;
  background-color: #28a745;
  color: white;
  padding: 10px;
  font-size: 16px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

#btnPagar:hover {
  background-color: #218838;
}
