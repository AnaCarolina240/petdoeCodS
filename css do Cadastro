body {
  margin: 0;
  font-family: Arial, sans-serif;
  background-color: #f7f7f7;
}

header {
  background-color: #3aafa9;
  color: rgb(0, 0, 0);
  padding: 20px;
  text-align: center;
}

main {
  max-width: 1000px;
  margin: 20px auto;
  padding: 10px;
}

.add-professional, .filters {
  background-color: white;
  padding: 15px;
  border-radius: 8px;
  box-shadow: 0 0 10px rgba(58, 175, 169, 0.3);
  margin-bottom: 20px;
}

.add-professional input,
.add-professional textarea {
  width: 100%;
  padding: 8px;
  margin-top: 5px;
  margin-bottom: 10px;
  border-radius: 4px;
  border: 1px solid #feb14c;
}

.add-professional button {
  background-color: #b60e0d;
  color: white;
  border: none;
  padding: 8px 12px;
  border-radius: 4px;
  cursor: pointer;
}

.add-professional button:hover {
  background-color: #ff5d5d;
}

.filters select {
  padding: 8px;
  border-radius: 5px;
  border: 1px solid #ccc;
}

.freelancer-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
}

.freelancer-card {
  background-color: white;
  border-radius: 8px;
  padding: 15px;
  box-shadow: 0 0 10px rgba(58, 175, 169, 0.3);
  width: 250px;
  text-align: center;
}

.freelancer-card img {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  object-fit: cover;
  margin-bottom: 10px;
}

.freelancer-card h3 {
  margin-top: 0;
  color: #3aafa9;
}

.freelancer-card p {
  margin: 5px 0;
}

.freelancer-card .rating {
  color: #ffcc00;
  font-size: 1.2em;
}

.freelancer-card button {
  background-color: #d6d6d6;
  color: white;
  border: none;
  padding: 8px 12px;
  border-radius: 4px;
  cursor: pointer;
  width: 100%;
}

.freelancer-card button:hover {
  background-color: #5dd2d6;
}

footer {
  text-align: center;
  background-color: #3aafa9;
  color: white;
  padding: 10px;
  margin-top: 20px;
}
