/* General Styles and Variables */
@import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap");

:root {
  --primary-color: #40cee0; /* A vibrant blue/cyan, main branding color */
  --accent-yellow: #ffd75e; /* Yellow-orange, used for navigation and footer, as per original design intent */
  --text-dark: #000000; /* Pure black for main headings and strong text */
  --text-light: #333333; /* Dark gray for paragraphs and less prominent text */
  --light-gray-background: #f7f7f7; /* Very light gray for overall body background */
  --white-background: #ffffff; /* Pure white for cards, panels, and elements that pop */
  --red-accent: #ff6f6f; /* A soft red, used for some buttons */
  --shadow-color: rgba(58, 175, 169, 0.3); /* Teal-ish shadow for depth */
  --max-width: 1200px; /* Max content width */
}

/* Reset and Base Styles */
* {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

html,
body {
  scroll-behavior: smooth;
}

body {
  font-family: "Poppins", sans-serif;
  background-color: var(--light-gray-background);
}

.section__container {
  max-width: var(--max-width);
  padding: 5rem 1rem;
  margin: auto;
}

.section__subheader {
  font-size: 1.2rem;
  font-weight: 500;
  color: var(--text-light);
  text-align: center;
}

.section__header {
  font-size: 2.5rem;
  font-weight: 500;
  color: var(--text-dark);
  text-align: center;
  line-height: 3.5rem;
  margin-bottom: 2rem; /* Added spacing below headers */
}

img {
  display: block; /* Changed from flex to block for better image rendering consistency */
  width: 100%;
  height: auto; /* Ensure aspect ratio is maintained */
}

a {
  text-decoration: none;
  transition: 0.3s;
}

ul {
  list-style: none;
}

/* Navigation */
nav {
  position: fixed;
  isolation: isolate;
  width: 100%;
  z-index: 9;
}

.nav__header {
  padding: 1rem;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--accent-yellow);
}

.nav__logo a {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-dark);
}

.nav__menu__btn {
  font-size: 1.5rem;
  color: var(--text-dark);
  cursor: pointer;
}

.nav__links {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 2rem;
  background-color: var(--accent-yellow);
  transform: translateY(0); /* Default state for mobile, hidden */
  transition: transform 0.5s;
  z-index: -1;
}

.nav__links.open {
  transform: translateY(100%); /* Reveals nav links when 'open' class is added */
}

.nav__links a {
  font-weight: 500;
  color: var(--text-dark);
}

.nav__links a:hover {
  color: var(--primary-color);
}

/* Header Section */
header {
  padding-top: 5rem; /* Space for fixed nav */
  position: relative;
  isolation: isolate;
  background-color: var(--primary-color);
}

.header__bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 3rem;
  background-color: var(--white-background);
  z-index: -1;
}

.header__container {
  padding-block: 2rem 0;
  display: grid;
  gap: 2rem;
}

.header__content {
  padding-block: 2rem 5rem; /* This was causing extra space, adjusted */
  padding-inline: 1rem;
}

.header__content h4 {
  max-width: fit-content;
  margin-inline: auto;
  margin-bottom: 1rem;
  padding: 5px 15px;
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-dark);
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 5rem;
}

.header__content h1 {
  margin-bottom: 1rem;
  font-size: 3.5rem;
  font-weight: 700;
  line-height: 4.5rem;
  color: var(--text-dark);
  text-align: center;
}

.header__content h1 span {
  font-size: 5rem;
}

.header__content h2 {
  margin-bottom: 1rem;
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--text-dark);
  text-align: center;
}

.header__content p {
  margin-bottom: 2rem;
  color: var(--text-light);
  text-align: center;
}

.header__btn button {
  padding-block: 0.5rem;
  padding-inline: 1.5rem 0.5rem;
  margin-inline: auto;
  outline: none;
  border: none;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1rem;
  color: var(--text-dark);
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 5rem;
  transition: 0.3s;
  cursor: pointer;
}

.header__btn button span {
  padding: 5px 7px;
  font-size: 1.5rem;
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 100%;
}

.header__btn button:hover {
  color: var(--white-background); /* Changed from --white to --white-background */
  background-color: rgba(0, 0, 0, 0.4);
}

.header__btn button:hover span {
  background-color: rgba(0, 0, 0, 0.4);
}

.header__image {
  position: relative;
  isolation: isolate;
}

.header__image img {
  max-width: 400px;
  margin-inline: auto;
}

/* Campaign (Fleet) Section */
.fleet__container {
  padding-block: 5rem;
}

.fleet__container :is(.section__subheader, .section__header) {
  padding-inline: 1rem;
}

.fleet__container .section__description {
  max-width: 900px;
  margin-inline: auto;
  margin-bottom: 4rem;
  padding-inline: 1rem;
  text-align: center; /* Ensures description is centered */
}

.fleet__wrapper-1 {
  margin-bottom: 1rem;
}

.fleet__wrapper-1,
.fleet__wrapper-2 {
  overflow-x: hidden;
}

.fleet__images {
  width: max-content;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.fleet__wrapper-1 .fleet__images {
  animation: scroll-left 45s linear infinite;
}

.fleet__wrapper-2 .fleet__images {
  animation: scroll-right 45s linear infinite;
}

.fleet__images img {
  border-radius: 1rem;
  box-shadow: 5px 5px 20px rgba(0, 0, 0, 0.1);
}

.fleet__wrapper-1 .fleet__images img {
  max-width: 450px;
}

.fleet__wrapper-2 .fleet__images img {
  max-width: 300px;
}

@keyframes scroll-left {
  to {
    transform: translateX(calc(-50% - 0.5rem));
  }
}

@keyframes scroll-right {
  from {
    transform: translateX(calc(-50% - 0.5rem));
  }
}

/* About Section */
.about__row {
  margin-top: 2rem;
  display: flex;
  gap: 2rem;
  flex-direction: column; /* Default to column for mobile */
  overflow: hidden;
}

.about__row:nth-child(3) {
  margin-top: 4rem;
}

.about__image {
  flex: 1;
  max-width: 400px;
  margin-inline: auto;
}

.about__content {
  flex: 1;
  text-align: center;
}

.about__content span {
  margin-inline: auto;
  margin-bottom: 1rem;
  width: 80px;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 100%;
}

.about__content span img {
  max-width: 40px;
}

/* Specific background colors for about icons */
.about__row:nth-child(1) .about__content span {
  background-color: #ffbf60; /* Adjusted for first row in HTML */
}

.about__row:nth-child(2) .about__content span {
  background-color: #257ae7; /* Adjusted for second row in HTML */
}

.about__row:nth-child(3) .about__content span {
  background-color: #ff8f80; /* Adjusted for third row in HTML */
}

.about__content h4 {
  max-width: 450px;
  margin-inline: auto;
  margin-bottom: 1rem;
  font-size: 2rem;
  font-weight: 500;
  color: var(--text-dark);
  line-height: 3rem;
}

.about__content p {
  max-width: 450px;
  margin-inline: auto;
  color: var(--text-light);
}

/* ONGs Section */
.add-professional,
.filters {
  background-color: var(--white-background);
  padding: 15px;
  border-radius: 8px;
  box-shadow: 0 0 10px var(--shadow-color);
  margin-bottom: 20px;
  text-align: center; /* Added for filters consistency */
}

.add-professional form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: 500px;
  margin: 0 auto;
}

.add-professional label {
  text-align: left;
  font-weight: 600;
  color: var(--text-dark);
}

.add-professional input,
.add-professional textarea {
  width: 100%;
  padding: 8px;
  border-radius: 4px;
  border: 1px solid var(--primary-color); /* Using variable */
}

.add-professional button {
  background-color: var(--red-accent);
  color: var(--white-background);
  border: none;
  padding: 10px 15px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 1rem;
  transition: background-color 0.3s ease;
}

.add-professional button:hover {
  background-color: var(--primary-color); /* More consistent hover */
}

.filters select {
  padding: 8px;
  border-radius: 5px;
  border: 1px solid var(--primary-color); /* Adjusted border for filters */
  margin: 5px; /* Added margin for spacing */
}

#listaOngs {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
  margin-top: 20px;
}

.ong-card {
  background-color: var(--white-background);
  border-radius: 8px;
  padding: 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  width: 100%; /* Default to full width for small screens */
  max-width: 350px; /* Max width for larger cards */
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ong-card h3 {
  color: var(--primary-color);
  margin-bottom: 10px;
  font-size: 1.5rem;
}

.ong-card p {
  margin-bottom: 5px;
  color: var(--text-light);
}

.ong-card p strong {
  color: var(--text-dark);
}

.ong-card a {
  color: var(--primary-color);
  text-decoration: underline;
}

.ong-card a:hover {
  color: var(--red-accent);
}

/* Map Section */
#map {
  height: 500px;
  width: 100%;
  border-radius: 8px;
  box-shadow: 0 0 10px var(--shadow-color); /* Added shadow for map */
}

.controls {
  background-color: var(--accent-yellow);
  padding: 15px;
  border-radius: 8px;
  box-shadow: 0 0 10px var(--shadow-color);
  margin-bottom: 20px;
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.search-bar,
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.search-bar input {
  padding: 8px;
  border: 1px solid var(--text-dark);
  border-radius: 4px;
  flex: 1;
  min-width: 120px;
}

.search-bar button {
  padding: 8px 12px;
  background-color: var(--red-accent);
  color: var(--white-background);
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.search-bar button:hover {
  background-color: var(--primary-color);
}

.filter-bar label {
  margin-right: 15px;
  white-space: nowrap; /* Prevent wrapping for labels */
}

/* Animal Photo Scroll (Banner) */
.banner__container {
  padding-block: 5rem;
  overflow: hidden;
}

.banner__wrapper {
  width: max-content;
  display: flex;
  align-items: center;
  gap: 8rem;
  animation: scroll 45s linear infinite;
}

.banner__wrapper img {
  height: 100px;
  width: auto; /* Ensure aspect ratio */
}

@keyframes scroll {
  to {
    transform: translateX(calc(-50% - 4rem));
  }
}

/* Services Section */
.service__flex {
  margin-top: 4rem;
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 2rem;
  flex-wrap: wrap;
}

.service__card div {
  margin-bottom: 1rem; /* Reduced margin */
  width: 100px; /* Smaller icon container */
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ff8f80; /* Specific color */
  border-radius: 100%;
}

.service__card img {
  max-width: 40px; /* Smaller icon size */
}

.service__card p {
  font-weight: 500;
  color: var(--text-light);
  text-align: center; /* Center the text under the icon */
}

/* Testimonials (Client) Section */
.client {
  background-color: var(--primary-color);
}

.swiper {
  margin-top: 4rem;
  width: 100%;
  padding-bottom: 3rem; /* Space for pagination/navigation if added */
}

.swiper-slide {
  min-width: 300px; /* Adjusted min-width for better mobile display */
  padding: 0 10px; /* Add some padding to see separation */
}

.client__card {
  padding: 1.5rem;
  background-color: var(--white-background);
  border-radius: 1rem;
  transition: 0.3s;
  height: 100%; /* Ensure cards take full height in a row */
  display: flex;
  flex-direction: column;
  justify-content: space-between; /* Distribute content */
}

.client__details {
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.client__details img {
  max-width: 50px;
  height: 50px; /* Fixed height for consistent circles */
  border-radius: 100%;
  object-fit: cover; /* Ensure image covers the circle */
}

.client__details h4 {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--text-dark);
}

.client__details h5 {
  font-weight: 500;
  color: var(--text-light);
}

.client__card p {
  color: var(--text-dark);
  flex-grow: 1; /* Allow paragraph to take available space */
}

/* Instagram Section */
.instagram__container p {
  max-width: fit-content;
  margin-bottom: 1rem;
  padding: 6px 20px;
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-dark);
  background-color: #e6e3fa; /* Specific color */
  border-radius: 5rem;
  margin-inline: auto; /* Center "SEGUIR" */
}

.instagram__container .section__header {
  padding-bottom: 1rem;
  text-align: center; /* Center "Instagram" */
  border-bottom: none; /* Removed border as it looked odd centered */
  margin-bottom: 2rem;
}

.instagram__grid {
  margin-top: 2rem;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem; /* Added gap for grid images */
}

.instagram__grid img {
  width: 100%;
  height: 150px; /* Fixed height for uniform grid */
  object-fit: cover; /* Ensure images fill their space */
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

/* Footer */
footer {
  text-align: center;
  background-color: var(--accent-yellow);
  color: var(--text-dark);
  padding: 1rem;
  margin-top: 20px;
}

.footer__container {
  display: grid;
  gap: 4rem 2rem;
}

.footer__logo a {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--text-dark);
}

.footer__col h4 {
  margin-bottom: 1rem;
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--text-dark);
}

.footer__links {
  display: grid;
  gap: 1rem;
}

.footer__links a {
  font-weight: 500;
  color: var(--text-dark);
}

.footer__links a:hover {
  color: var(--primary-color);
}

.footer__col p {
  margin-bottom: 1rem;
  color: var(--text-dark);
}

.footer__col form {
  width: 100%;
  display: flex;
  align-items: center;
  border: 2px solid var(--primary-color);
  border-radius: 5rem;
  overflow: hidden; /* Ensure button stays inside */
}

.footer__col form input {
  padding-inline: 0.5rem;
  padding-block: 0.5rem; /* Added vertical padding */
  width: 100%;
  outline: none;
  border: none;
  font-size: 1rem;
  color: var(--text-dark);
  background-color: transparent;
}

.footer__col form button {
  padding: 0.5rem 1.5rem; /* Adjusted padding */
  outline: none;
  border: none;
  color: var(--text-dark);
  font-size: 1.5rem; /* Smaller icon size */
  background-color: var(--primary-color);
  border-radius: 0 5rem 5rem 0; /* Only right corners rounded */
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.footer__col form button:hover {
  background-color: var(--red-accent);
}

.footer__socials {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
  justify-content: center; /* Center social icons */
}

.footer__socials a {
  display: inline-block;
  padding: 5px 8px;
  font-size: 1.125rem;
  color: var(--text-dark);
  background-color: var(--primary-color);
  border-radius: 100%;
  transition: background-color 0.3s ease;
}

.footer__socials a:hover {
  background-color: var(--red-accent);
}

.footer__bar {
  padding: 1rem;
  font-size: 0.9rem;
  color: var(--text-light);
  text-align: center;
}

/* Freelancer Section */
.freelancer-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
  margin-top: 20px; /* Space from filter */
}

.freelancer-card {
  background-color: var(--white-background);
  border-radius: 8px;
  padding: 15px;
  box-shadow: 0 0 10px var(--primary-color);
  width: 250px;
  text-align: center;
  border: 1px solid var(--primary-color);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.freelancer-card img {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  object-fit: cover;
  margin-bottom: 10px;
  display: block;
  margin-inline: auto;
}

.freelancer-card h3 {
  margin-top: 0;
  color: var(--primary-color);
  font-size: 1.4rem;
  margin-bottom: 5px;
}

.freelancer-card p {
  margin: 5px 0;
  color: var(--text-light);
}

.freelancer-card p strong {
  color: var(--text-dark);
}

.freelancer-card .rating {
  color: #ffcc00; /* Specific color for stars */
  font-size: 1.2em;
  margin-top: 10px;
  margin-bottom: 15px;
}

.freelancer-card button {
  background-color: var(--red-accent);
  color: var(--white-background);
  border: none;
  padding: 8px 12px;
  border-radius: 4px;
  cursor: pointer;
  width: 100%;
  font-size: 1rem;
  transition: background-color 0.3s ease;
}

.freelancer-card button:hover {
  background-color: var(--primary-color);
}

.hidden {
  display: none;
}

/* Back to Top Button */
#topBtn {
  background: none;
  border: none;
  cursor: pointer;
  position: fixed;
  bottom: 80px;
  right: 40px;
  width: 60px;
  height: 60px;
  display: none; /* Controlled by JS */
  z-index: 1000;
  padding: 0;
}

#topBtn img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* Media Queries */
@media (width > 540px) {
  .header__content h1 {
    font-size: 4.5rem;
    line-height: 5rem;
  }

  .header__content h1 span {
    font-size: 6rem;
  }

  .instagram__grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .footer__container {
    grid-template-columns: repeat(2, 1fr);
  }

  .swiper-slide {
    min-width: 350px; /* Adjust for larger screens */
  }

  .ong-card {
    width: calc(50% - 10px); /* Two cards per row with gap */
  }
}

@media (width > 768px) {
  nav {
    position: static;
    padding: 2rem 1rem;
    max-width: var(--max-width);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav__header {
    padding: 0;
    background-color: transparent;
  }

  .nav__logo a {
    font-size: 1.5rem;
  }

  .nav__menu__btn {
    display: none;
  }

  .nav__links {
    position: static;
    padding: 0;
    flex-direction: row;
    justify-content: flex-end;
    background-color: transparent;
    transform: none; /* No translation for desktop */
  }

  header {
    padding-top: 0;
  }

  .header__container {
    grid-template-columns: repeat(2, 1fr);
    align-items: center;
  }

  .header__content {
    grid-area: 1/2/2/3; /* Places content on the right for desktop */
  }

  .header__content :is(h4, .header__btn button) {
    margin-inline-start: unset;
  }

  .header__content :is(h1, h2) {
    text-align: left;
  }

  .header__content p {
    max-width: 400px;
    text-align: left;
  }

  .header__image img {
    max-width: 500px;
  }

  .about__row {
    flex-direction: row; /* Rows for desktop */
    align-items: center;
  }

  .about__row:nth-child(2) {
    flex-direction: row-reverse; /* Alternating order for second row */
  }

  .about__content {
    text-align: left;
  }

  .footer__container {
    grid-template-columns: repeat(4, 1fr);
  }

  .swiper-slide {
    min-width: unset; /* Remove min-width, let Swiper handle it */
  }

  .ong-card {
    width: calc(33.33% - 13.33px); /* Three cards per row with gap */
  }

  .controls {
    flex-direction: row; /* Controls in a row for larger screens */
    justify-content: space-between;
    align-items: center;
  }

  .search-bar {
    flex-grow: 1; /* Allow search bar to take available space */
  }
}
