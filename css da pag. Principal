
@import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap");

:root {
  --primary-color: #40cee0; 
  --accent-yellow: #ffd75e; 
  --text-dark: #000000; 
  --text-light: #333333; 
  --light-gray-background: #f7f7f7; 
  --white-background: #ffffff; 
  --red-accent: #ff6f6f; 
  --shadow-color: rgba(58, 175, 169, 0.3); 
  --max-width: 1200px; /* Largura máxima do conteúdo */
}

/* Estilo de Redefinição e Base */

* {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

html,
body {
  scroll-behavior: smooth;
}

body {
  font-family: "Poppins", sans-serif;
  background-color: var(--light-gray-background);
}

.section__container {
  max-width: var(--max-width);
  padding: 5rem 1rem;
  margin: auto;
}

.section__subheader {
  font-size: 1.2rem;
  font-weight: 500;
  color: var(--text-light);
  text-align: center;
}

.section__header {
  font-size: 2.5rem;
  font-weight: 500;
  color: var(--text-dark);
  text-align: center;
  line-height: 3.5rem;
  margin-bottom: 2rem; /* Adiciona espaçamento abaixo dos cabeçalhos */
}

img {
  display: block; 
  width: 100%;
  height: auto; /* Certifica de que a proporção seja mantida */
}

a {
  text-decoration: none;
  transition: 0.3s;
}

ul {
  list-style: none;
}

/* Navegação */

nav {
  position: fixed;
  isolation: isolate;
  width: 100%;
  z-index: 9;
}

.nav__header {
  padding: 1rem;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--accent-yellow);
}

.nav__logo a {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-dark);
}

.nav__menu__btn {
  font-size: 1.5rem;
  color: var(--text-dark);
  cursor: pointer;
}

.nav__links {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 2rem;
  background-color: var(--accent-yellow);
  transform: translateY(0); /* Estado padrão para celular, oculto */
  transition: transform 0.5s;
  z-index: -1;
}

.nav__links.open {
  transform: translateY(100%); /* Revela os links de navegação quando a classe 'open' é adicionada */
}

.nav__links a {
  font-weight: 500;
  color: var(--text-dark);
}

.nav__links a:hover {
  color: var(--primary-color);
}

/* Seção de Cabeçalho */

header {
  padding-top: 5rem; /* Espaço para navegação fixa */
  position: relative;
  isolation: isolate;
  background-color: var(--primary-color);
}

.header__bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 3rem;
  background-color: var(--white-background);
  z-index: -1;
}

.header__container {
  padding-block: 2rem 0;
  display: grid;
  gap: 2rem;
}

.header__content {
  padding-block: 2rem 5rem; 
  padding-inline: 1rem;
}

.header__content h4 {
  max-width: fit-content;
  margin-inline: auto;
  margin-bottom: 1rem;
  padding: 5px 15px;
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-dark);
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 5rem;
}

.header__content h1 {
  margin-bottom: 1rem;
  font-size: 3.5rem;
  font-weight: 700;
  line-height: 4.5rem;
  color: var(--text-dark);
  text-align: center;
}

.header__content h1 span {
  font-size: 5rem;
}

.header__content h2 {
  margin-bottom: 1rem;
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--text-dark);
  text-align: center;
}

.header__content p {
  margin-bottom: 2rem;
  color: var(--text-light);
  text-align: center;
}

.header__btn button {
  padding-block: 0.5rem;
  padding-inline: 1.5rem 0.5rem;
  margin-inline: auto;
  outline: none;
  border: none;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1rem;
  color: var(--text-dark);
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 5rem;
  transition: 0.3s;
  cursor: pointer;
}

.header__btn button span {
  padding: 5px 7px;
  font-size: 1.5rem;
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 100%;
}

.header__btn button:hover {
  color: var(--white-background); /* Mudado de --branco para --fundo-branco */
  background-color: rgba(0, 0, 0, 0.4);
}

.header__btn button:hover span {
  background-color: rgba(0, 0, 0, 0.4);
}

.header__image {
  position: relative;
  isolation: isolate;
}

.header__image img {
  max-width: 400px;
  margin-inline: auto;
}

/* Seção de Campanha */

.fleet__container {
  padding-block: 5rem;
}

.fleet__container :is(.section__subheader, .section__header) {
  padding-inline: 1rem;
}

.fleet__container .section__description {
  max-width: 900px;
  margin-inline: auto;
  margin-bottom: 4rem;
  padding-inline: 1rem;
  text-align: center; /* Garante que a descrição esteja centralizada */
}

.fleet__wrapper-1 {
  margin-bottom: 1rem;
}

.fleet__wrapper-1,
.fleet__wrapper-2 {
  overflow-x: hidden;
}

.fleet__images {
  width: max-content;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.fleet__wrapper-1 .fleet__images {
  animation: scroll-left 45s linear infinite;
}

.fleet__wrapper-2 .fleet__images {
  animation: scroll-right 45s linear infinite;
}

.fleet__images img {
  border-radius: 1rem;
  box-shadow: 5px 5px 20px rgba(0, 0, 0, 0.1);
}

.fleet__wrapper-1 .fleet__images img {
  max-width: 450px;
}

.fleet__wrapper-2 .fleet__images img {
  max-width: 300px;
}

@keyframes scroll-left {
  to {
    transform: translateX(calc(-50% - 0.5rem));
  }
}

@keyframes scroll-right {
  from {
    transform: translateX(calc(-50% - 0.5rem));
  }
}

/* Seção Sobre */

.about__row {
  margin-top: 2rem;
  display: flex;
  gap: 2rem;
  flex-direction: column; /* Define como coluna padrão para mobile */
  overflow: hidden;
}

.about__row:nth-child(3) {
  margin-top: 4rem;
}

.about__image {
  flex: 1;
  max-width: 400px;
  margin-inline: auto;
}

.about__content {
  flex: 1;
  text-align: center;
}

.about__content span {
  margin-inline: auto;
  margin-bottom: 1rem;
  width: 80px;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 100%;
}

.about__content span img {
  max-width: 40px;
}

/* Cores de fundo específicas para ícones de informações */

.about__row:nth-child(1) .about__content span {
  background-color: #ffbf60; /* Ajusta para a primeira linha em HTML */
}

.about__row:nth-child(2) .about__content span {
  background-color: #40cee0; /* Ajusta para a segunda linha em HTML */
}

.about__row:nth-child(3) .about__content span {
  background-color: #ff8f80; /* Ajusta para a terceira linha em HTML */
}

.about__content h4 {
  max-width: 450px;
  margin-inline: auto;
  margin-bottom: 1rem;
  font-size: 2rem;
  font-weight: 500;
  color: var(--text-dark);
  line-height: 3rem;
}

.about__content p {
  max-width: 450px;
  margin-inline: auto;
  color: var(--text-light);
}



/* Seção de ONGs */

.add-professional,
.filters {
  background-color: var(--white-background);
  padding: 15px;
  border-radius: 8px;
  box-shadow: 0 0 10px var(--shadow-color);
  margin-bottom: 20px;
  text-align: center; /* Adiciona para consistência dos filtros */
}

.add-professional form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: 500px;
  margin: 0 auto;
}

.add-professional label {
  text-align: left;
  font-weight: 600;
  color: var(--text-dark);
}

.add-professional input,
.add-professional textarea {
  width: 100%;
  padding: 8px;
  border-radius: 4px;
  border: 1px solid var(--primary-color); /* Uso de variável */
}

.add-professional button {
  background-color: var(--red-accent);
  color: var(--white-background);
  border: none;
  padding: 10px 10px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 1rem;
  transition: background-color 0.3s ease;
}

.add-professional button {
  width: fit-content; /* Ou algo como 150px */
  margin: 0 auto;      /* Centraliza o botão se ele não for 100% */
}

.add-professional button:hover {
  background-color: var(--primary-color); 
}

.filters select {
  padding: 8px;
  border-radius: 5px;
  border: 1px solid var(--primary-color); /* Borda ajustada para filtros */
  margin: 5px; /* Adiciona margem para espaçamento */
}

#listaOngs {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
  margin-top: 20px;
}

.ong-card {
  background-color: var(--white-background);
  border-radius: 8px;
  padding: 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  width: 100%; /* Define como largura total para telas pequenas */
  max-width: 350px; /* Largura máxima para cartões maiores */
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ong-card h3 {
  color: var(--primary-color);
  margin-bottom: 10px;
  font-size: 1.5rem;
}

.ong-card p {
  margin-bottom: 5px;
  color: var(--text-light);
}

.ong-card p strong {
  color: var(--text-dark);
}

.ong-card a {
  color: var(--primary-color);
  text-decoration: underline;
}

.ong-card a:hover {
  color: var(--red-accent);
}

/* Seção do Mapa */

#map {
  height: 500px;
  width: 100%;
  border-radius: 8px;
  box-shadow: 0 0 10px var(--shadow-color); /* Sombra adicionada ao mapa */
}

.controls {
  background-color: var(--accent-yellow);
  padding: 15px;
  border-radius: 8px;
  box-shadow: 0 0 10px var(--shadow-color);
  margin-bottom: 20px;
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.search-bar,
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.search-bar input {
  padding: 8px;
  border: 1px solid var(--text-dark);
  border-radius: 4px;
  flex: 1;
  min-width: 120px;
}

.search-bar button {
  padding: 8px 12px;
  background-color: var(--red-accent);
  color: var(--white-background);
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.search-bar button:hover {
  background-color: var(--primary-color);
}

.filter-bar label {
  margin-right: 15px;
  white-space: nowrap; /* Impedir a quebra para rótulos */
}

/* Rolagem de Fotos de Animais (Banner) */
.banner__container {
  padding-block: 5rem;
  overflow: hidden;
}

.banner__wrapper {
  width: max-content;
  display: flex;
  align-items: center;
  gap: 8rem;
  animation: scroll 45s linear infinite;
}

.banner__wrapper img {
  height: 100px;
  width: auto; /* Manter a proporção */
}

@keyframes scroll {
  to {
    transform: translateX(calc(-50% - 4rem));
  }
}

/* Seção de Serviços */

.service__flex {
  margin-top: 4rem;
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 2rem;
  flex-wrap: wrap;
}

.service__card div {
  margin-bottom: 1rem; /* Reduzir margem */
  width: 100px; /* Container de ícone menor */
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ff8f80; /* Cor específica */
  border-radius: 100%;
}

.service__card img {
  max-width: 40px; /* Tamanho menor do ícone */
}

.service__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}


.service__card p {
  font-weight: 500;
  color: var(--text-light);
  text-align: center; /* Centraliza o texto abaixo do ícone */
}

/* Comentarios */

.client {
  background-color: var(--primary-color);
}

.swiper {
  margin-top: 4rem;
  width: 100%;
  padding-bottom: 3rem; /* Espaço para pagina, se adicionado */
}

.swiper-slide {
  min-width: 300px; /* Largura mínima ajustada para  exibição em dispositivos */
  padding: 0 10px; /* Adiciona um pouco de espaçamento para ver a separação */
}

.client__card {
  padding: 1.5rem;
  background-color: #ffd75e;
  border-radius: 1rem;
  transition: 0.3s;
  height: 100%; /* Certifique-se de que os cards ocupem toda a altura em uma linha */
  display: flex;
  flex-direction: column;
  justify-content: space-between; /* Distribui conteúdo */
}

.client__details {
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.client__details img {
  max-width: 50px;
  height: 50px; /* Altura fixa para círculos consistentes */
  border-radius: 100%;
  object-fit: cover; /* Certifica de que a imagem cubra o círculo */
}

.client__details h4 {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--text-dark);
}

.client__details h5 {
  font-weight: 500;
  color: var(--text-light);
}

.client__card p {
  color: var(--text-dark);
  flex-grow: 1; /* Permiti que o parágrafo ocupe o espaço disponível */
}

/* Seção do Instagram */

.instagram__container p {
  max-width: fit-content;
  margin-bottom: 1rem;
  padding: 6px 20px;
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-dark);
  background-color: #ffd75e; /* Cor específica */
  border-radius: 5rem;
  margin-inline: auto; /* Centro "SEGUIR" */
}

.instagram__container .section__header {
  padding-bottom: 1rem;
  text-align: center; /* Centro "Instagram" */
  border-bottom: none; /* Removi a borda pois parecia estranha centralizada */
  margin-bottom: 2rem;
}

.instagram__grid {
  margin-top: 2rem;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem; /* Adicionado espaço para imagens de grade */
}

.instagram__grid img {
  width: 100%;
  height: 150px; /* Altura fixa para grade uniforme */
  object-fit: cover; /* Certifique-se de que as imagens preencham seu espaço */
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

/* Rodapé */

footer {
  text-align: center;
  background-color: var(--accent-yellow);
  color: var(--text-dark);
  padding: 1rem;
  margin-top: 20px;
}

.footer__container {
  display: grid;
  gap: 4rem 2rem;
}

.footer__logo a {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--text-dark);
}

.footer__col h4 {
  margin-bottom: 1rem;
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--text-dark);
}

.footer__links {
  display: grid;
  gap: 1rem;
}

.footer__links a {
  font-weight: 500;
  color: var(--text-dark);
}

.footer__links a:hover {
  color: var(--primary-color);
}

.footer__col p {
  margin-bottom: 1rem;
  color: var(--text-dark);
}

.footer__col form {
  width: 100%;
  display: flex;
  align-items: center;
  border: 2px solid var(--primary-color);
  border-radius: 5rem;
  overflow: hidden; /* Certifique-se de que o botão permaneça dentro */
}

.footer__col form input {
  padding-inline: 0.5rem;
  padding-block: 0.5rem; /* Adicionou preenchimento vertical */
  width: 100%;
  outline: none;
  border: none;
  font-size: 1rem;
  color: var(--text-dark);
  background-color: transparent;
}

.footer__col form button {
  padding: 0.5rem 1.5rem; /* Reforço de preenchimento */
  outline: none;
  border: none;
  color: var(--text-dark);
  font-size: 1.5rem; /* Tamanho menor do ícone */
  background-color: var(--primary-color);
  border-radius: 0 5rem 5rem 0; /* Somente os cantos direitos arredondados */
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.footer__col form button:hover {
  background-color: var(--red-accent);
}

.footer__socials {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
  justify-content: center; /* Ícones sociais do centro */
}

.footer__socials a {
  display: inline-block;
  padding: 5px 8px;
  font-size: 1.125rem;
  color: var(--text-dark);
  background-color: var(--primary-color);
  border-radius: 100%;
  transition: background-color 0.3s ease;
}

.footer__socials a:hover {
  background-color: var(--red-accent);
}

.footer__bar {
  padding: 1rem;
  font-size: 0.9rem;
  color: var(--text-light);
  text-align: center;
}

/* Seção de Freelancer */

.freelancer-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
  margin-top: 20px; /* Espaço do filtro */
}

.freelancer-card {
  background-color: var(--white-background);
  border-radius: 8px;
  padding: 15px;
  box-shadow: 0 0 10px var(--primary-color);
  width: 250px;
  text-align: center;
  border: 1px solid var(--primary-color);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.freelancer-card img {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  object-fit: cover;
  margin-bottom: 10px;
  display: block;
  margin-inline: auto;
}

.freelancer-card h3 {
  margin-top: 0;
  color: var(--primary-color);
  font-size: 1.4rem;
  margin-bottom: 5px;
}

.freelancer-card p {
  margin: 5px 0;
  color: var(--text-light);
}

.freelancer-card p strong {
  color: var(--text-dark);
}

.freelancer-card .rating {
  color: #ffcc00; /* Cor específica para estrelas */
  font-size: 1.2em;
  margin-top: 10px;
  margin-bottom: 15px;
}

.freelancer-card button {
  background-color: var(--red-accent);
  color: var(--white-background);
  border: none;
  padding: 8px 12px;
  border-radius: 4px;
  cursor: pointer;
  width: 100%;
  font-size: 1rem;
  transition: background-color 0.3s ease;
}

.freelancer-card button:hover {
  background-color: var(--primary-color);
}

.hidden {
  display: none;
}

/* Botão Voltar ao Topo */

#topBtn {
  background: none;
  border: none;
  cursor: pointer;
  position: fixed;
  bottom: 80px;
  right: 40px;
  width: 60px;
  height: 60px;
  display: none; /* Controlado por JS */
  z-index: 1000;
  padding: 0;
}

#topBtn img {
  width: 150%;
  height: 150%;
  object-fit: contain;
}

/* Consultas de Mídia */

@media (width > 540px) {
  .header__content h1 {
    font-size: 4.5rem;
    line-height: 5rem;
  }

  .header__content h1 span {
    font-size: 6rem;
  }

  .instagram__grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .footer__container {
    grid-template-columns: repeat(2, 1fr);
  }

  .swiper-slide {
    min-width: 350px; /* Ajustar para telas maiores */
  }

  .ong-card {
    width: calc(50% - 10px); /* Dois cartões por linha com espaço */
  }
}

@media (width > 768px) {
  nav {
    position: static;
    padding: 2rem 1rem;
    max-width: var(--max-width);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav__header {
    padding: 0;
    background-color: transparent;
  }

  .nav__logo a {
    font-size: 1.5rem;
  }

  .nav__menu__btn {
    display: none;
  }

  .nav__links {
    position: static;
    padding: 0;
    flex-direction: row;
    justify-content: flex-end;
    background-color: transparent;
    transform: none; /* Nenhuma tradução para desktop */
  }

  header {
    padding-top: 0;
  }

  .header__container {
    grid-template-columns: repeat(2, 1fr);
    align-items: center;
  }

  .header__content {
    grid-area: 1/2/2/3; /* Coloca o conteúdo à direita para desktop */
  }

  .header__content :is(h4, .header__btn button) {
    margin-inline-start: unset;
  }

  .header__content :is(h1, h2) {
    text-align: left;
  }

  .header__content p {
    max-width: 400px;
    text-align: left;
  }

  .header__image img {
    max-width: 500px;
  }

  .about__row {
    flex-direction: row; /*Linhas para desktop*/
    align-items: center;
  }

  .about__row:nth-child(2) {
    flex-direction: row-reverse; /* Ordem alternada para a segunda linha */
  }

  .about__content {
    text-align: left;
  }

  .footer__container {
    grid-template-columns: repeat(4, 1fr);
  }

  .swiper-slide {
    min-width: unset; /* Remova a largura mínima, deixe o Swiper lidar com isso. */
  }

  .ong-card {
    width: calc(33.33% - 13.33px); /* Três cartões por linha com espaço */
  }

  .controls {
    flex-direction: row; /* Controles em linha para telas maiores */
    justify-content: space-between;
    align-items: center;
  }

  .search-bar {
    flex-grow: 1; /* Allow search bar to take available space */
  }
}
